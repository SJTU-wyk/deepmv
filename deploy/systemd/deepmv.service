[Unit]
Description=DeepMV 影视聚合服务
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deepmv
Group=deepmv
WorkingDirectory=/opt/deepmv/server
Environment=NODE_ENV=production
EnvironmentFile=-/etc/deepmv.env
ExecStart=/usr/bin/node dist/index.js

# ---- 24 小时运行 ----
Restart=always
RestartSec=5
# 5 分钟内重启超过 10 次就停手，避免崩溃循环把 CPU 打满
StartLimitIntervalSec=300
StartLimitBurst=10
TimeoutStopSec=20

# ---- 沙箱：服务被拿下也翻不出这个目录 ----
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/deepmv/server/share /opt/deepmv/server/data
# 免费档机器普遍 1GB 内存，留余量给系统和 Caddy
MemoryMax=800M
CPUWeight=50

# ---- 日志限流，防止 journal 把磁盘写满 ----
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200

[Install]
WantedBy=multi-user.target
