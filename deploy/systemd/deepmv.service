[Unit]
Description=DeepMV 影视聚合服务
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deepmv
Group=deepmv
WorkingDirectory=/opt/deepmv/server
Environment=NODE_ENV=production
Environment=DEEPMV_MODE=public
Environment=DEEPMV_RATE=90
Environment=ALLOW_PROXY=0
# 口令写在这里，chmod 600。不写就是公开访问
EnvironmentFile=-/etc/deepmv.env
ExecStart=/usr/bin/node --experimental-strip-types src/index.ts
Restart=always
RestartSec=5

# 沙箱：服务被拿下也翻不出这个目录
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/deepmv/server/share
MemoryMax=700M

[Install]
WantedBy=multi-user.target
